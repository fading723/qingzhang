{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": false,
    "types": ["node", "react"]
  },
  "include": [
    "App.tsx",
    "index.ts",
    "app.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "android", "ios", ".tools", "artifacts"]
}
